RESPONDA_APP_NAME="Responda API"
RESPONDA_ENVIRONMENT="development"
RESPONDA_MOBILE_DEV_OTP_ENABLED=false
RESPONDA_MOBILE_BETA_ACCOUNTS_ENABLED=false
RESPONDA_DEBUG=true
RESPONDA_API_VERSION="1.0.0"
RESPONDA_API_V1_PREFIX="/api/v1"

# Replace this value before using a shared, staging, or production environment.
RESPONDA_SECRET_KEY="development-only-change-me"

# Local PostgreSQL connection used by the application and Alembic migrations.
RESPONDA_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/responda"
RESPONDA_DATABASE_POOL_SIZE=5
RESPONDA_DATABASE_MAX_OVERFLOW=10
RESPONDA_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Admin dashboard authentication. Secure cookies must be true outside local development/testing.
RESPONDA_ADMIN_SESSION_COOKIE_NAME="responda_admin_session"
RESPONDA_ADMIN_SESSION_COOKIE_SECURE=false
RESPONDA_ADMIN_SESSION_TTL_SECONDS=28800
RESPONDA_ADMIN_MAX_SESSIONS_PER_USER=5
RESPONDA_ADMIN_LOGIN_RATE_LIMIT_ATTEMPTS=5
RESPONDA_ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Leave false unless the API is behind a trusted reverse proxy that strips client-supplied headers.
RESPONDA_TRUST_PROXY_HEADERS=false

# JSON array containing the local client URLs permitted by CORS.
RESPONDA_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]'
